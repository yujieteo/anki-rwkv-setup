{
  "permissions": {
    "deny": [
      "Bash(./install-macos.sh)",
      "Bash(./install-macos.sh *)",
      "Bash(bash install-macos.sh)",
      "Bash(bash install-macos.sh *)",
      "Bash(bash ./install-macos.sh)",
      "Bash(bash ./install-macos.sh *)",
      "Bash(sh install-macos.sh)",
      "Bash(sh install-macos.sh *)",
      "Bash(sh ./install-macos.sh)",
      "Bash(sh ./install-macos.sh *)",
      "Bash(zsh install-macos.sh)",
      "Bash(zsh install-macos.sh *)",
      "Bash(zsh ./install-macos.sh)",
      "Bash(zsh ./install-macos.sh *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-installer.py\"",
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/test-build.sh\"",
            "timeout": 120,
            "statusMessage": "Test-building the deck..."
          }
        ]
      }
    ]
  }
}
